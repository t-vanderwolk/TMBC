generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(cuid())
  email                     String                    @unique
  password                  String
  name                      String?
  role                      Role                      @default(MEMBER)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  myRegistryAccessToken     String?
  myRegistryRefreshToken    String?
  myRegistryTokenExpires    DateTime?
  myRegistryLastSyncedAt    DateTime?
  pinterestAccessToken      String?
  pinterestRefreshToken     String?
  pinterestTokenExpires     DateTime?
  myRegistryEmail           String?
  myRegistryUserId          String?
  disabled                  Boolean                   @default(false)
  dueDate                   DateTime?
  inviteCodeUsed            Boolean                   @default(false)
  location                  String?
  mentorId                  String?
  onboardingComplete        Boolean                   @default(false)
  profileCompleted          Boolean                   @default(false)
  myRegistryRegistryId      String?
  myRegistryCreatedAt       DateTime?
  mentorCollabRequestedAt   DateTime?
  mentorCollabConfirmedAt   DateTime?
  mentorCollabEmail         String?
  academyProgress           AcademyProgress[]
  affiliateEvents           AffiliateEvent[]
  authoredBlogPosts         BlogPost[]                @relation("BlogAuthor")
  reviewedBlogPosts         BlogPost[]                @relation("BlogReviewer")
  memberChatMessages        ChatMessage[]             @relation("MemberChatMessages")
  mentorChatMessages        ChatMessage[]             @relation("MentorChatMessages")
  sentChatMessages          ChatMessage[]             @relation("ChatMessageSender")
  communityPosts            CommunityPost[]
  communityReplies          CommunityReply[]
  compareEvents             CompareEvent[]
  conversationMessages      ConversationMessage[]     @relation("ConversationMessageSender")
  hostedEvents              Event[]                   @relation("HostedEvents")
  externalRegistries        ExternalRegistry[]        @relation("ExternalRegistryOwner")
  externalRegistryNotes     ExternalRegistryNote[]    @relation("ExternalRegistryNoteAuthor")
  intakeResponses           IntakeResponse[]
  invites                   Invite[]                  @relation("CreatedInvites")
  consumedInvite            Invite?                   @relation("ConsumedInvite")
  redeemedInvite            InviteCode?               @relation("RedeemedInvite")
  approvedInvites           InviteRequest[]           @relation("InviteApprover")
  journalEntries            JournalEntry[]
  loginEvents               LoginEvent[]
  mentorFeedbackReceived    MentorFeedback[]          @relation("MentorFeedbackMember")
  mentorFeedbackAuthored    MentorFeedback[]          @relation("MentorFeedbackMentor")
  mentorNotesReceived       MentorNote[]              @relation("MemberMentorNotes")
  mentorNotes               MentorNote[]              @relation("MentorNotesMentor")
  mentorSuggestionsReceived MentorProductSuggestion[] @relation("MemberSuggestions")
  mentorSuggestionsAuthored MentorProductSuggestion[] @relation("MentorSuggestions")
  mentorTasksMember         MentorTask[]              @relation("MentorTasksMember")
  mentorTasksMentor         MentorTask[]              @relation("MentorTasksMentor")
  onboardingProfile         OnboardingProfile?
  partnerProfile            PartnerProfile?
  planSections              PlanSection[]             @relation("MemberPlanSections")
  reviewedPlanSections      PlanSection[]             @relation("PlanSectionReviewedBy")
  profile                   Profile?
  registry                  Registry?                 @relation("UserRegistry")
  registryConflicts         RegistryConflict[]
  registryItems             RegistryItem[]
  timeCapsules              TimeCapsule[]
  mentor                    User?                     @relation("Mentorship", fields: [mentorId], references: [id])
  mentees                   User[]                    @relation("Mentorship")
  workbookEntries           WorkbookEntry[]
  conversations             Conversation[]            @relation("ConversationParticipants")
}

model AffiliateEvent {
  id            String   @id @default(uuid())
  userId        String
  affiliateName String
  affiliateType String
  network       String
  merchantId    String
  eventType     String
  payoutValue   Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, affiliateName])
}

model BlogAffiliateEvent {
  id              String             @id @default(cuid())
  blogPostId      String
  affiliateLinkId String
  event           AffiliateEventType
  createdAt       DateTime           @default(now())
  affiliateLink   BlogAffiliateLink  @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  blogPost        BlogPost           @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([affiliateLinkId])
  @@index([event])
}

model BlogPost {
  id                 String                @id @default(cuid())
  slug               String                @unique
  title              String
  excerpt            String?
  content            Json
  heroImage          String?
  status             BlogStatus            @default(DRAFT)
  isAffiliate        Boolean               @default(true)
  publishedAt        DateTime?
  authorId           String
  authorName         String
  authorRoleSnapshot BlogAuthorRole
  tags               String[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  submittedAt        DateTime?
  rejectionNote      String?
  reviewerId         String?
  affiliateEvents    BlogAffiliateEvent[]
  affiliateLinks     BlogAffiliateLink[]
  engagementEvents   BlogEngagementEvent[]
  highlights         BlogHighlight[]
  highlightEvents    BlogHighlightEvent[]
  author             User                  @relation("BlogAuthor", fields: [authorId], references: [id])
  reviewer           User?                 @relation("BlogReviewer", fields: [reviewerId], references: [id])

  @@index([status, isAffiliate])
  @@index([publishedAt])
}

model BlogAffiliateLink {
  id              String               @id @default(cuid())
  blogPostId      String
  partnerName     String
  network         AffiliateNetwork
  label           String
  position        AffiliatePosition
  destinationUrl  String
  isPrimary       Boolean              @default(false)
  createdAt       DateTime             @default(now())
  affiliateEvents BlogAffiliateEvent[]
  blogPost        BlogPost             @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([partnerName])
}

model BlogEngagementEvent {
  id         String             @id @default(cuid())
  blogPostId String
  event      BlogEngagementType
  viewerId   String?
  metadata   Json?
  createdAt  DateTime           @default(now())
  blogPost   BlogPost           @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([event])
  @@index([createdAt])
}

model BlogHighlight {
  id         String               @id @default(cuid())
  blogPostId String
  productId  String?
  brandName  String?
  note       String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  blogPost   BlogPost             @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  product    Product?             @relation(fields: [productId], references: [id])
  events     BlogHighlightEvent[]

  @@index([blogPostId])
  @@index([productId])
  @@index([brandName])
}

model BlogHighlightEvent {
  id          String                 @id @default(cuid())
  blogPostId  String
  highlightId String
  event       BlogHighlightEventType
  createdAt   DateTime               @default(now())
  blogPost    BlogPost               @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  highlight   BlogHighlight          @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([highlightId])
  @@index([event])
  @@index([createdAt])
}

model Registry {
  id              String         @id @default(cuid())
  userId          String         @unique
  myRegistryId    String         @unique
  title           String?
  source          String         @default("MYREGISTRY")
  createdAt       DateTime       @default(now())
  lastSyncedAt    DateTime?
  shippingAddress Json?
  compareEvents   CompareEvent[]
  user            User           @relation("UserRegistry", fields: [userId], references: [id], onDelete: Cascade)
  items           RegistryItem[] @relation("RegistryItems")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  role      Role?
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Profile {
  id              String         @id @default(cuid())
  userId          String         @unique
  city            String?
  dueDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  firstName       String?
  inviteRequestId String?        @unique
  lastName        String?
  state           String?
  imageUrl        String?
  preferredName   String?
  inviteRequest   InviteRequest? @relation(fields: [inviteRequestId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
}

model PartnerProfile {
  id        String            @id @default(cuid())
  userId    String            @unique
  name      String?
  roleLabel PartnerRoleLabel?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  answers           Json
  recommendations   Json
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lifestyleSnapshot Json?
  user              User     @relation(fields: [userId], references: [id])
}

model IntakeResponse {
  id        Int      @id @default(autoincrement())
  userId    String
  step      String?
  responses Json
  tags      String[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Invite {
  id             String    @id @default(cuid())
  code           String    @unique
  role           Role      @default(MEMBER)
  createdById    String
  used           Boolean   @default(false)
  usedAt         DateTime?
  usedById       String?   @unique
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  createdByEmail String?
  email          String?
  maxUses        Int       @default(1)
  sentAt         DateTime?
  createdBy      User      @relation("CreatedInvites", fields: [createdById], references: [id])
  usedBy         User?     @relation("ConsumedInvite", fields: [usedById], references: [id])
}

model InviteCode {
  id           String    @id @default(cuid())
  code         String    @unique
  email        String?
  used         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  redeemedById String?   @unique
  usedAt       DateTime?
  redeemedBy   User?     @relation("RedeemedInvite", fields: [redeemedById], references: [id])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model InviteRequest {
  id           String   @id @default(cuid())
  email        String   @unique
  status       String   @default("pending")
  inviteCode   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  approvedById String?
  firstName    String?
  lastName     String?
  message      String?
  approvedBy   User?    @relation("InviteApprover", fields: [approvedById], references: [id])
  profile      Profile?
}

model Product {
  id                String                    @id @default(cuid())
  name              String
  brand             String?
  category          String
  imageUrl          String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  description       String?
  notes             String?
  subcategory       String?
  affiliateLinks    AffiliateLink[]
  blogHighlights    BlogHighlight[]
  mentorNotes       MentorNote[]
  mentorSuggestions MentorProductSuggestion[]
  priceSnapshots    PriceSnapshot[]
  registryItems     RegistryItem[]
}

model RegistryItem {
  id                String                      @id @default(cuid())
  userId            String
  productId         String
  title             String?
  url               String?
  merchant          String?
  category          String?
  image             String?
  price             Float?
  myRegistryId      String?
  notes             String?
  quantity          Int?
  purchaseSource    String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  affiliateId       String?
  affiliateLink     String?
  brand             String?
  externalGiftId    String?
  imageUrl          String?
  name              String?
  registryId        String?
  source            String?
  myRegistryItemId  String?
  addedByMentor     Boolean                     @default(false)
  mentorNote        String?
  purchasedAt       DateTime?
  section           RegistrySection
  userNote          String?
  status            RegistryItemStatus          @default(CONSIDERING)
  decisionStatus    RegistryDecisionStatus?
  mentorFeedback    MentorFeedback[]            @relation("RegistryFeedback")
  registryConflicts RegistryConflict[]
  affiliate         AffiliatePartner?           @relation(fields: [affiliateId], references: [id])
  product           Product                     @relation(fields: [productId], references: [id])
  registry          Registry?                   @relation("RegistryItems", fields: [registryId], references: [id])
  user              User                        @relation(fields: [userId], references: [id])
  blogInfluences    RegistryItemBlogInfluence[]
  priceWatch        RegistryPriceWatch?

  @@index([affiliateId])
}

model CompareEvent {
  id         String          @id @default(cuid())
  userId     String
  registryId String
  category   String
  itemIds    String[]
  decision   CompareDecision
  source     CompareSource
  createdAt  DateTime        @default(now())
  registry   Registry        @relation(fields: [registryId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([registryId])
  @@index([category])
}

model RegistryItemBlogInfluence {
  id             String       @id @default(cuid())
  registryItemId String
  postSlug       String
  createdAt      DateTime     @default(now())
  registryItem   RegistryItem @relation(fields: [registryItemId], references: [id], onDelete: Cascade)

  @@index([registryItemId])
  @@index([postSlug])
}

/// INTENTIONAL: Affiliate click tracking is deferred until the admin analytics pipeline is finalized.
model AffiliateLink {
  id           String           @id @default(cuid())
  productId    String
  retailerName String
  network      AffiliateNetwork
  outboundUrl  String
  affiliateId  String?
  region       String?
  isPrimary    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MentorNote {
  id        String         @id @default(cuid())
  memberId  String
  mentorId  String
  productId String?
  content   String         @map("note")
  createdAt DateTime       @default(now())
  moduleId  String?
  updatedAt DateTime       @updatedAt
  member    User           @relation("MemberMentorNotes", fields: [memberId], references: [id], onDelete: Cascade)
  mentor    User           @relation("MentorNotesMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  module    AcademyModule? @relation("ModuleMentorNotes", fields: [moduleId], references: [id])
  product   Product?       @relation(fields: [productId], references: [id])

  @@index([memberId])
  @@index([mentorId])
}

model MentorProductSuggestion {
  id         String    @id @default(cuid())
  mentorId   String
  memberId   String
  category   String
  productId  String
  note       String?
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  member     User      @relation("MemberSuggestions", fields: [memberId], references: [id], onDelete: Cascade)
  mentor     User      @relation("MentorSuggestions", fields: [mentorId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id])

  @@index([mentorId])
  @@index([memberId])
  @@index([category])
}

model ExternalRegistry {
  id            String                 @id @default(cuid())
  memberId      String
  provider      String
  title         String?
  url           String?
  documentUrl   String?
  documentLabel String?
  referenceOnly Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  member        User                   @relation("ExternalRegistryOwner", fields: [memberId], references: [id], onDelete: Cascade)
  notes         ExternalRegistryNote[]

  @@index([memberId])
}

model ExternalRegistryNote {
  id         String           @id @default(cuid())
  registryId String
  authorId   String
  note       String
  createdAt  DateTime         @default(now())
  author     User             @relation("ExternalRegistryNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  registry   ExternalRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  @@index([registryId])
  @@index([authorId])
}

model AcademyModule {
  id              String            @id
  title           String
  trackId         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  content         Json              @default("{}")
  heroImage       String?
  subtitle        String?
  description     String?
  slug            String            @unique
  order           Int
  published       Boolean           @default(false)
  journey         AcademyJourney    @default(nursery)
  progress        AcademyProgress[]
  communityRoom   CommunityRoom?    @relation("ModuleRoom")
  mentorFeedback  MentorFeedback[]
  mentorNotes     MentorNote[]      @relation("ModuleMentorNotes")
  workbookEntries WorkbookEntry[]
}

model AcademyProgress {
  id        String        @id @default(cuid())
  userId    String
  moduleId  String
  completed Boolean       @default(false)
  updatedAt DateTime      @updatedAt
  module    AcademyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model CommunityRoom {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  moduleId    String?         @unique
  minRole     Role            @default(MEMBER)
  createdAt   DateTime        @default(now())
  posts       CommunityPost[]
  module      AcademyModule?  @relation("ModuleRoom", fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model CommunityPost {
  id              String                  @id @default(cuid())
  roomId          String
  userId          String
  content         String
  sourcePrompt    String?
  createdAt       DateTime                @default(now())
  isAnnouncement  Boolean                 @default(false)
  isAnonymous     Boolean                 @default(false)
  isMentorPrompt  Boolean                 @default(false)
  isPinned        Boolean                 @default(false)
  pinnedAt        DateTime?
  sourceSection   WorkbookSection?
  workbookEntryId String?
  sourceType      CommunityPostSourceType @default(COMMUNITY)
  room            CommunityRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies         CommunityReply[]

  @@index([roomId])
  @@index([userId])
  @@index([isAnnouncement])
}

model CommunityReply {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  type        String?
  format      String?
  hostId      String?
  hostName    String?
  status      String      @default("scheduled")
  location    String?
  description String?
  startTime   DateTime
  endTime     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  host        User?       @relation("HostedEvents", fields: [hostId], references: [id])
  rsvps       EventRsvp[]
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  status    String   @default("confirmed")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
}

model AdminSettings {
  id                   Int      @id @default(1)
  inviteOnly           Boolean  @default(true)
  defaultMentorId      String?
  pinterestClientId    String?
  pinterestSecret      String?
  myRegistryMerchantId String?
  affiliateNetwork     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MentorFeedback {
  id             String         @id @default(uuid())
  mentorId       String
  memberId       String
  moduleId       String?
  registryItemId String?
  message        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  member         User           @relation("MentorFeedbackMember", fields: [memberId], references: [id])
  mentor         User           @relation("MentorFeedbackMentor", fields: [mentorId], references: [id])
  module         AcademyModule? @relation(fields: [moduleId], references: [id])
  registryItem   RegistryItem?  @relation("RegistryFeedback", fields: [registryItemId], references: [id])
}

model ChatMessage {
  id         String   @id @default(cuid())
  mentorId   String
  memberId   String
  senderId   String
  senderRole Role
  content    String
  createdAt  DateTime @default(now())
  member     User     @relation("MemberChatMessages", fields: [memberId], references: [id])
  mentor     User     @relation("MentorChatMessages", fields: [mentorId], references: [id])
  sender     User     @relation("ChatMessageSender", fields: [senderId], references: [id])
}

model Conversation {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  messages     ConversationMessage[]
  participants User[]                @relation("ConversationParticipants")
}

model ConversationMessage {
  id             String       @id @default(cuid())
  content        String
  createdAt      DateTime     @default(now())
  conversationId String
  senderId       String
  /// INTENTIONAL: Read receipts will be honored once chat UX supports them end-to-end.
  readAt         DateTime?
  /// INTENTIONAL: System notes are reserved for future concierge workflows.
  isSystem       Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("ConversationMessageSender", fields: [senderId], references: [id])
}

model MentorTask {
  id          String   @id @default(uuid())
  mentorId    String
  memberId    String
  type        String
  referenceId String?
  title       String
  description String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  member      User     @relation("MentorTasksMember", fields: [memberId], references: [id])
  mentor      User     @relation("MentorTasksMentor", fields: [mentorId], references: [id])
}

model JournalEntry {
  id          String           @id @default(cuid())
  userId      String
  type        JournalEntryType
  title       String?
  content     String
  emotionTags String[]         @default([])
  isPrivate   Boolean          @default(true)
  sourceLabel String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}

model JournalShare {
  id        String   @id @default(uuid())
  journalId String
  memberId  String
  mentorId  String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TimeCapsule {
  id           Int       @id @default(autoincrement())
  userId       String
  type         String
  content      Json
  scheduledFor DateTime?
  isPrivate    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RegistryConflict {
  id          String       @id @default(cuid())
  userId      String
  itemId      String
  field       String
  localValue  String?
  remoteValue String?
  resolved    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  item        RegistryItem @relation(fields: [itemId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([itemId])
  @@index([userId, resolved])
}

model PriceSnapshot {
  id                 String            @id @default(cuid())
  productId          String
  affiliatePartnerId String?
  price              Float
  currency           String
  capturedAt         DateTime          @default(now())
  affiliatePartner   AffiliatePartner? @relation(fields: [affiliatePartnerId], references: [id])
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([affiliatePartnerId])
  @@index([capturedAt])
}

model RegistryPriceWatch {
  id                 String       @id @default(cuid())
  registryItemId     String       @unique
  watchStartedAt     DateTime     @default(now())
  purchaseRecordedAt DateTime?
  lastNotifiedAt     DateTime?
  registryItem       RegistryItem @relation(fields: [registryItemId], references: [id], onDelete: Cascade)
}

model AffiliatePartner {
  id             String           @id
  name           String
  network        AffiliateNetwork
  awinmid        Int?
  cookieDays     Int?
  regions        String[]         @default([])
  defaultLink    String?
  createdAt      DateTime         @default(now())
  priceSnapshots PriceSnapshot[]
  items          RegistryItem[]
}

model MessageThread {
  id        Int       @id @default(autoincrement())
  title     String?
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        Int           @id @default(autoincrement())
  threadId  Int
  senderId  String
  content   String
  createdAt DateTime      @default(now())
  thread    MessageThread @relation(fields: [threadId], references: [id])
}

model WorkbookEntry {
  id        String            @id @default(cuid())
  userId    String
  moduleId  String
  type      WorkbookEntryType
  content   Json
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  module    AcademyModule     @relation(fields: [moduleId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([userId, moduleId, type])
  @@index([userId])
  @@index([moduleId])
}

model PlanSection {
  id                    String    @id @default(cuid())
  memberId              String
  sectionKey            String
  decisionState         String    @default("UNDECIDED")
  memberNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  mentorSummary         String?
  readyState            String    @default("NOT_READY")
  reviewedAt            DateTime?
  reviewedById          String?
  memberAcknowledgement String?
  mentorNote            String?
  updatedByRole         String?   @default("MEMBER")
  member                User      @relation("MemberPlanSections", fields: [memberId], references: [id], onDelete: Cascade)
  reviewedBy            User?     @relation("PlanSectionReviewedBy", fields: [reviewedById], references: [id])

  @@unique([memberId, sectionKey])
  @@index([memberId])
  @@index([reviewedById])
}

