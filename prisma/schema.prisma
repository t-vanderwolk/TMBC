generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  password               String
  name                   String?
  role                   Role               @default(MEMBER)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  myRegistryAccessToken  String?
  myRegistryRefreshToken String?
  myRegistryTokenExpires DateTime?
  myRegistryLastSyncedAt DateTime?
  pinterestAccessToken   String?
  pinterestRefreshToken  String?
  pinterestTokenExpires  DateTime?
  myRegistryEmail        String?
  myRegistryUserId       String?
  myRegistryRegistryId   String?
  myRegistryCreatedAt    DateTime?
  disabled               Boolean            @default(false)
  dueDate                DateTime?
  inviteCodeUsed         Boolean            @default(false)
  location               String?
  mentorId               String?
  onboardingComplete     Boolean            @default(false)
  profileCompleted       Boolean            @default(false)
  academyProgress        AcademyProgress[]
  memberChatMessages     ChatMessage[]      @relation("MemberChatMessages")
  mentorChatMessages     ChatMessage[]      @relation("MentorChatMessages")
  sentChatMessages       ChatMessage[]      @relation("ChatMessageSender")
  conversations          Conversation[]     @relation("ConversationParticipants")
  conversationMessages   ConversationMessage[] @relation("ConversationMessageSender")
  communityPosts         CommunityPost[]
  communityReplies       CommunityReply[]
  hostedEvents           Event[]            @relation("HostedEvents")
  invites                Invite[]           @relation("CreatedInvites")
  consumedInvite         Invite?            @relation("ConsumedInvite")
  redeemedInvite         InviteCode?        @relation("RedeemedInvite")
  approvedInvites        InviteRequest[]    @relation("InviteApprover")
  loginEvents            LoginEvent[]
  mentorFeedbackReceived MentorFeedback[]   @relation("MentorFeedbackMember")
  mentorFeedbackAuthored MentorFeedback[]   @relation("MentorFeedbackMentor")
  mentorNotesReceived    MentorNote[]       @relation("MemberMentorNotes")
  mentorNotes            MentorNote[]       @relation("MentorNotesMentor")
  mentorTasksMember      MentorTask[]       @relation("MentorTasksMember")
  mentorTasksMentor      MentorTask[]       @relation("MentorTasksMentor")
  onboardingProfile      OnboardingProfile?
  profile                Profile?
  registryConflicts      RegistryConflict[]
  registryItems          RegistryItem[]
  mentor                 User?              @relation("Mentorship", fields: [mentorId], references: [id])
  mentees                User[]             @relation("Mentorship")
  intakeResponses        IntakeResponse[]
  timeCapsules           TimeCapsule[]
  workbookEntries        WorkbookEntry[]
  registry               Registry?          @relation("UserRegistry")
  affiliateEvents        AffiliateEvent[]
}

model AffiliateEvent {
  id            String   @id @default(uuid())
  userId        String
  affiliateName String
  affiliateType String
  network       String
  merchantId    String
  eventType     String
  payoutValue   Float
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, affiliateName])
}

model Registry {
  id           String         @id @default(cuid())
  userId       String         @unique
  myRegistryId String         @unique
  title        String?
  source       String         @default("MYREGISTRY")
  createdAt    DateTime       @default(now())
  lastSyncedAt DateTime?
  shippingAddress Json?
  user         User           @relation("UserRegistry", fields: [userId], references: [id], onDelete: Cascade)
  items        RegistryItem[] @relation("RegistryItems")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  role      Role?
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Profile {
  id              String         @id @default(cuid())
  userId          String         @unique
  city            String?
  dueDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  firstName       String?
  imageUrl        String?
  inviteRequestId String?        @unique
  lastName        String?
  state           String?
  inviteRequest   InviteRequest? @relation(fields: [inviteRequestId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
}

model OnboardingProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  answers         Json
  recommendations Json
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model IntakeResponse {
  id        Int      @id @default(autoincrement())
  userId    String
  step      String?
  responses Json
  tags      String[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Invite {
  id             String    @id @default(cuid())
  code           String    @unique
  role           Role      @default(MEMBER)
  createdById    String
  used           Boolean   @default(false)
  usedAt         DateTime?
  usedById       String?   @unique
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  createdByEmail String?
  email          String?
  maxUses        Int       @default(1)
  createdBy      User      @relation("CreatedInvites", fields: [createdById], references: [id])
  usedBy         User?     @relation("ConsumedInvite", fields: [usedById], references: [id])
}

model InviteCode {
  id           String    @id @default(cuid())
  code         String    @unique
  email        String?
  used         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  redeemedById String?   @unique
  usedAt       DateTime?
  redeemedBy   User?     @relation("RedeemedInvite", fields: [redeemedById], references: [id])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model InviteRequest {
  id           String   @id @default(cuid())
  email        String   @unique
  status       String   @default("pending")
  inviteCode   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  approvedById String?
  firstName    String?
  lastName     String?
  message      String?
  approvedBy   User?    @relation("InviteApprover", fields: [approvedById], references: [id])
  profile      Profile?
}

model Product {
  id            String         @id @default(cuid())
  name          String
  brand         String?
  category      String
  subcategory   String?
  description   String?
  imageUrl      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  affiliateLinks AffiliateLink[]
  registryItems  RegistryItem[]
  mentorNotes    MentorNote[]
}

model RegistryItem {
  id               String              @id @default(cuid())
  userId           String
  productId        String
  registryId       String?
  externalGiftId   String?
  myRegistryId     String?
  myRegistryItemId String?
  name             String?
  title            String?
  url              String?
  brand            String?
  merchant         String?
  category         String?
  price            Float?
  quantity         Int?
  image            String?
  imageUrl         String?
  affiliateId      String?
  affiliateLink    String?
  source           String?
  purchaseSource   String?
  section          RegistrySection
  status           RegistryItemStatus @default(CONSIDERING)
  mentorNote       String?
  userNote         String?
  notes            String?
  addedByMentor    Boolean             @default(false)
  purchasedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user    User             @relation(fields: [userId], references: [id])
  product Product          @relation(fields: [productId], references: [id])
  registry Registry?       @relation("RegistryItems", fields: [registryId], references: [id])
  affiliate AffiliatePartner? @relation(fields: [affiliateId], references: [id])

  mentorFeedback    MentorFeedback[]   @relation("RegistryFeedback")
  registryConflicts RegistryConflict[]
  blogInfluences    RegistryItemBlogInfluence[]

  @@index([affiliateId])
}

model RegistryItemBlogInfluence {
  id             String       @id @default(cuid())
  registryItemId String
  postSlug       String
  createdAt      DateTime     @default(now())

  registryItem RegistryItem @relation(fields: [registryItemId], references: [id], onDelete: Cascade)

  @@index([registryItemId])
  @@index([postSlug])
}

/// TODO: Affiliate click tracking
model AffiliateLink {
  id           String           @id @default(cuid())
  productId    String
  retailerName String
  network      AffiliateNetwork
  outboundUrl  String
  affiliateId  String?
  region       String?
  isPrimary    Boolean          @default(false)
  createdAt    DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// TODO: Conversion webhooks
/// TODO: International storefront routing

model MentorNote {
  id        String         @id @default(cuid())
  memberId  String
  mentorId  String
  productId String?
  content   String         @map("note")
  createdAt DateTime       @default(now())
  moduleId  String?
  updatedAt DateTime       @updatedAt
  member    User           @relation("MemberMentorNotes", fields: [memberId], references: [id], onDelete: Cascade)
  mentor    User           @relation("MentorNotesMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  module    AcademyModule? @relation("ModuleMentorNotes", fields: [moduleId], references: [id])
  product   Product?       @relation(fields: [productId], references: [id])

  @@index([memberId])
  @@index([mentorId])
}

model AcademyModule {
  id              String            @id
  title           String
  trackId         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  content         Json              @default("{}")
  heroImage       String?
  subtitle        String?
  description     String?
  journey         AcademyJourney    @default(nursery)
  slug            String            @unique
  order           Int
  published       Boolean           @default(false)
  progress        AcademyProgress[]
  mentorFeedback  MentorFeedback[]
  mentorNotes     MentorNote[]      @relation("ModuleMentorNotes")
  workbookEntries WorkbookEntry[]
  communityRoom   CommunityRoom?    @relation("ModuleRoom")
}

model AcademyProgress {
  id        String        @id @default(cuid())
  userId    String
  moduleId  String
  completed Boolean       @default(false)
  updatedAt DateTime      @updatedAt
  module    AcademyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model CommunityRoom {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  moduleId    String?
  minRole     Role            @default(MEMBER)
  createdAt   DateTime        @default(now())
  module      AcademyModule?  @relation("ModuleRoom", fields: [moduleId], references: [id], onDelete: Cascade)
  posts       CommunityPost[]

  @@index([moduleId])
  @@unique([moduleId])
}

model CommunityPost {
  id             String        @id @default(cuid())
  roomId         String
  userId         String
  content        String
  sourcePrompt   String?
  createdAt      DateTime      @default(now())
  isAnnouncement Boolean       @default(false)
  isPinned       Boolean       @default(false)
  pinnedAt       DateTime?
  room           CommunityRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies        CommunityReply[]
  workbookEntryId String? 
  sourceType     CommunityPostSourceType @default(COMMUNITY)
  sourceSection  WorkbookSection?
  isAnonymous    Boolean                 @default(false)
  isMentorPrompt Boolean                 @default(false)

  @@index([roomId])
  @@index([userId])
  @@index([isAnnouncement])
}

model CommunityReply {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  type        String?
  format      String?
  hostId      String?
  hostName    String?
  status      String      @default("scheduled")
  location    String?
  description String?
  startTime   DateTime
  endTime     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  host        User?       @relation("HostedEvents", fields: [hostId], references: [id])
  rsvps       EventRsvp[]
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  status    String   @default("confirmed")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
}

model AdminSettings {
  id                   Int      @id @default(1)
  inviteOnly           Boolean  @default(true)
  defaultMentorId      String?
  pinterestClientId    String?
  pinterestSecret      String?
  myRegistryMerchantId String?
  affiliateNetwork     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MentorFeedback {
  id             String         @id @default(uuid())
  mentorId       String
  memberId       String
  moduleId       String?
  registryItemId String?
  message        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  member         User           @relation("MentorFeedbackMember", fields: [memberId], references: [id])
  mentor         User           @relation("MentorFeedbackMentor", fields: [mentorId], references: [id])
  module         AcademyModule? @relation(fields: [moduleId], references: [id])
  registryItem   RegistryItem?  @relation("RegistryFeedback", fields: [registryItemId], references: [id])
}

model ChatMessage {
  id         String   @id @default(cuid())
  mentorId   String
  memberId   String
  senderId   String
  senderRole Role
  content    String
  createdAt  DateTime @default(now())
  member     User     @relation("MemberChatMessages", fields: [memberId], references: [id])
  mentor     User     @relation("MentorChatMessages", fields: [mentorId], references: [id])
  sender     User     @relation("ChatMessageSender", fields: [senderId], references: [id])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants User[] @relation("ConversationParticipants")
  messages     ConversationMessage[]
}

model ConversationMessage {
  id             String       @id @default(cuid())
  content        String
  createdAt      DateTime     @default(now())
  readAt         DateTime?    /// TODO: honor read receipts in future UX.
  isSystem       Boolean      @default(false) /// TODO: flag concierge/system notes for later workflows.

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User   @relation("ConversationMessageSender", fields: [senderId], references: [id])
}

model MentorTask {
  id          String   @id @default(uuid())
  mentorId    String
  memberId    String
  type        String
  referenceId String?
  title       String
  description String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  member      User     @relation("MentorTasksMember", fields: [memberId], references: [id])
  mentor      User     @relation("MentorTasksMentor", fields: [mentorId], references: [id])
}

model JournalShare {
  id        String   @id @default(uuid())
  journalId String
  memberId  String
  mentorId  String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TimeCapsule {
  id           Int      @id @default(autoincrement())
  userId       String
  type         String
  content      Json
  scheduledFor DateTime?
  isPrivate    Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RegistryConflict {
  id          String       @id @default(cuid())
  userId      String
  itemId      String
  field       String
  localValue  String?
  remoteValue String?
  resolved    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  item        RegistryItem @relation(fields: [itemId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([itemId])
  @@index([userId, resolved])
}

model AffiliatePartner {
  id          String           @id
  name        String
  network     AffiliateNetwork
  awinmid     Int?
  cookieDays  Int?
  regions     String[]         @default([])
  defaultLink String?
  createdAt   DateTime         @default(now())
  items       RegistryItem[]
}

model MessageThread {
  id        Int      @id @default(autoincrement())
  title     String?
  createdAt DateTime @default(now())
  messages  Message[]
}

model Message {
  id        Int      @id @default(autoincrement())
  threadId  Int
  senderId  String
  content   String
  createdAt DateTime @default(now())
  thread    MessageThread @relation(fields: [threadId], references: [id])
}
model WorkbookEntry {
  id        String            @id @default(cuid())
  userId    String
  moduleId  String
  type      WorkbookEntryType
  content   Json
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  module    AcademyModule     @relation(fields: [moduleId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([userId, moduleId, type])
  @@index([userId])
  @@index([moduleId])
}

enum AcademyJourney {
  gear
  nursery
  postpartum
}

enum Role {
  MEMBER
  MENTOR
  ADMIN
}

enum RegistryStatus {
  ACTIVE
  NEEDED
  RESERVED
  PURCHASED
  PURCHASED_ELSEWHERE
  REMOVED_REMOTE
}

enum AffiliateNetwork {
  CJ
  IMPACT
  AWIN
  SHAREASALE
  MYREGISTRY
  DIRECT
}

enum RegistrySection {
  NURSERY
  GEAR
  FEEDING
  POSTPARTUM
  LATER
}

enum RegistryItemStatus {
  CONSIDERING
  ADDED
  PURCHASED
  REMOVED
}

enum WorkbookEntryType {
  JOURNAL
  MOODBOARD
  CHECKLIST
  REFLECTION
}

enum CommunityPostSourceType {
  COMMUNITY
  WORKBOOK
  MENTOR_PROMPT
}

enum WorkbookSection {
  REFLECT
  APPLY
  INTEGRATE
}
