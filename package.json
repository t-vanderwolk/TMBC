{
  "name": "tmbc-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0 <21",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/validateNode.js",
    "dev": "next dev",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prebuild": "ts-node --project tsconfig.json scripts/prebuild.ts",
    "build:preflight": "npm run prebuild && npm run typecheck",
    "build": "npm run build:preflight && next build",
    "build:ci": "npm run build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/fixTailwindMissingFiles.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^10.18.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.372.0",
    "next": "14.1.0",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-swipeable": "^7.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "20.11.30",
    "@types/react": "18.2.64",
    "@types/react-dom": "18.2.21",
    "autoprefixer": "10.4.17",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.3",
    "postcss": "8.4.35",
    "prisma": "^5.17.0",
    "semver": "^7.3.8",
    "tailwindcss": "3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "5.4.2"
  }
}
